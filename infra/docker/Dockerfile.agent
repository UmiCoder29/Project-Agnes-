FROM rust:1.80-slim as builder

WORKDIR /usr/src/agnes
COPY Cargo.toml Cargo.lock ./
COPY crates ./crates
COPY apps ./apps
COPY tests ./tests

RUN cargo build --release --bin mock-agent

FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y ca-certificates && rm -rf /var/lib/apt/lists/*

WORKDIR /app
COPY --from=builder /usr/src/agnes/target/release/mock-agent /usr/local/bin/mock-agent

ENV AGNES_GATEWAY_URL="http://agnes-core:8080"
ENV AGENT_ID="agent-001"

CMD ["mock-agent"]
